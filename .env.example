# Copy to .env ON THE EC2 SERVER. Never commit the populated file.
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com
# Origins only: no repository path or trailing slash. Separate multiple with commas.
CORS_ORIGINS=https://YOUR_USERNAME.github.io
# Generate with: openssl rand -hex 32
HERMES_ADMIN_TOKEN=
ALPHAVANTAGE_API_KEY=
# Optional trader feed endpoints/keys can be configured separately.
TRADER_REFRESH_INTERVAL_MINUTES=0
