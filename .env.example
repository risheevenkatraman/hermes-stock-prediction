# Copy to .env ON THE EC2 SERVER. Never commit the populated file.
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com
# Origins only: no repository path or trailing slash. Separate multiple with commas.
CORS_ORIGINS=https://app.example.com
# Generate with: openssl rand -hex 32
HERMES_ADMIN_TOKEN=
ALPHAVANTAGE_API_KEY=
# RDS PostgreSQL in production. URL-encode special characters in credentials.
# DATABASE_URL=postgresql+psycopg://hermes:PASSWORD@RDS_HOST:5432/hermes?sslmode=require
DATABASE_URL=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Optional worker archive bucket. Use an IAM role, not hardcoded AWS keys.
RESEARCH_BUCKET=
# Local publication history. Compose sets this to /data/forecast-history.
FORECAST_ARCHIVE_DIR=data/forecast-history
