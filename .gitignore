# Personal documentation stays local; README.md remains tracked.
/docs/

# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Local virtual environments
.venv/
venv/
env/
ENV/

# Local environment secrets (keep sanitized templates committable)
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template
.envrc

# Local AWS credentials and private keys
.aws/
.docker/
*.ppk
*.pem
*.key
*.p12
*.pfx

# Python packaging output
build/
dist/
*.egg-info/
.eggs/

# Local news archive
data/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.db
*.db-wal
*.db-shm
*.db-journal

# Local archive backups (uncompressed SQLite backups are covered above)
/backups/
*.sqlite.gz
*.sqlite3.gz
*.db.gz

# Browser test captures
tests/browser_artifacts/
playwright-report/
test-results/

# Local JavaScript dependencies and package-manager logs
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime logs
*.log
*.log.*
/logs/

# Personal editor state and operating-system files
.idea/
.vscode/*.local.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Keep benchmark snapshots/reports, source, and shared editor settings tracked.
